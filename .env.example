# DueRadar environment template.
# Copy to .env.local for local development; never commit real secrets.
# Render supplies these as encrypted environment variables in production.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Public origin of the web app (no trailing slash).
# Local development with Vite: http://localhost:5173
# Production: https://app.dueradar.cloud
# ---------------------------------------------------------------------------
APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# Use the pooled host for the app and worker. Use the direct host only for
# migrations that cannot run through the pooler, or for psql/pg_dump.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dueradar?sslmode=require
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Neon Auth (Managed Better Auth)
# Copy the branch's Auth base URL from the Neon console. The API proxies
# /api/auth/* to this URL so the session cookie stays first-party.
# ---------------------------------------------------------------------------
NEON_AUTH_BASE_URL=https://your-branch.neonauth.region.aws.neon.tech/dueradar/auth
# Comma-separated verified account email addresses allowed to use the admin dashboard.
# ADMIN_EMAILS=you@example.com
# Optional overrides. Normally derived from the base URL and its JWKS document.
# NEON_AUTH_JWKS_URL=
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=

# Force cookie security in a non-standard setup. By default this follows the
# APP_ORIGIN scheme: https gets Secure cookies, http does not.
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Static web app
# In development Vite serves the app and proxies /api. In production one
# container serves both, so SERVE_WEB=true and WEB_DIST is an absolute path.
# ---------------------------------------------------------------------------
SERVE_WEB=false
WEB_DIST=../web/dist

# ---------------------------------------------------------------------------
# Email (Resend)
# RESEND_API_KEY is also used by the worker for reminder emails.
# EMAIL_FROM must be on a domain verified in Resend.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
EMAIL_FROM="DueRadar <reminders@dueradar.cloud>"
SUPPORT_EMAIL=support@dueradar.cloud
# Inbound catch-all webhook signing secret.
# RESEND_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Phase 2 detection: forwarding, retention, optional LLM fallback
# ---------------------------------------------------------------------------
# Domain that receives forwarded mail. Use a bare domain, no scheme or @.
# The address a user sees is dr-<random>@<this domain>. Before custom-domain
# DNS exists, Resend's account-managed <id>.resend.app receiving domain works.
# INBOUND_EMAIL_DOMAIN=in.dueradar.cloud

# Raw pasted/forwarded text is erased after this many hours (1-72). Default 72.
DETECTION_RAW_RETENTION_HOURS=72

# Optional redacted fallback for messages the deterministic parsers cannot read.
# Off unless all four values are present and DETECTION_LLM_ENABLED=true.
# The endpoint must be OpenAI-compatible and support json_schema responses.
# DETECTION_LLM_ENABLED=false
# DETECTION_LLM_URL=https://api.openai.com/v1/chat/completions
# DETECTION_LLM_API_KEY=
# DETECTION_LLM_MODEL=gpt-4.1-mini
# DETECTION_LLM_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Optional Gmail scanning (restricted Google OAuth scope)
# Enable the Gmail API and create an OAuth web client. The callback URI is
# APP_ORIGIN/oauth/gmail/callback and must match exactly in Google Cloud.
# Public availability requires Google's restricted-scope verification; because
# DueRadar processes the message content on its server, a security assessment
# may also be required.
# Generate the token key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key stable and secret; changing it makes saved provider tokens unreadable.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# PROVIDER_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# Generate once with: npx web-push generate-vapid-keys
# The public key is exposed through /api/config; the private key never leaves
# the server environment.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@dueradar.cloud

# ---------------------------------------------------------------------------
# Paystack (GHS Plus payments)
# The secret key is used only by the API to initialize/verify hosted checkout
# and validate webhook signatures. Never expose it to the browser.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Worker (background reminder delivery)
# ---------------------------------------------------------------------------
POLL_INTERVAL_MS=15000
MAINTENANCE_INTERVAL_HOURS=6
