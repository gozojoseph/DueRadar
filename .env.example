# DueRadar environment template.
# Copy to .env.local for local development; never commit real secrets.
# Render supplies these as encrypted environment variables in production.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Public origin of the web app (no trailing slash).
# Local development with Vite: http://localhost:5173
# Production: https://app.dueradar.cloud
# ---------------------------------------------------------------------------
APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# Use the pooled host for the app and worker. Use the direct host only for
# migrations that cannot run through the pooler, or for psql/pg_dump.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dueradar?sslmode=require
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Neon Auth (Managed Better Auth)
# Copy the branch's Auth base URL from the Neon console. The API proxies
# /api/auth/* to this URL so the session cookie stays first-party.
# ---------------------------------------------------------------------------
NEON_AUTH_BASE_URL=https://your-branch.neonauth.region.aws.neon.tech/dueradar/auth
# Optional overrides. Normally derived from the base URL and its JWKS document.
# NEON_AUTH_JWKS_URL=
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=

# Force cookie security in a non-standard setup. By default this follows the
# APP_ORIGIN scheme: https gets Secure cookies, http does not.
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Static web app
# In development Vite serves the app and proxies /api. In production one
# container serves both, so SERVE_WEB=true and WEB_DIST is an absolute path.
# ---------------------------------------------------------------------------
SERVE_WEB=false
WEB_DIST=../web/dist

# ---------------------------------------------------------------------------
# Email (Resend)
# RESEND_API_KEY is also used by the worker for reminder emails.
# EMAIL_FROM must be on a domain verified in Resend.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
EMAIL_FROM="DueRadar <reminders@dueradar.cloud>"
SUPPORT_EMAIL=support@dueradar.cloud
# Inbound catch-all webhook signing secret.
# RESEND_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# Generate once with: npx web-push generate-vapid-keys
# The public key is exposed through /api/config; the private key never leaves
# the server environment.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@dueradar.cloud

# ---------------------------------------------------------------------------
# Worker (background reminder delivery)
# ---------------------------------------------------------------------------
POLL_INTERVAL_MS=15000
MAINTENANCE_INTERVAL_HOURS=6
